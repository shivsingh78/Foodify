# ---- Server ----
NODE_ENV=development
PORT=5000
# Browser origin allowed by CORS (required in production)
# Public origin of the app. Combined deployment: the single public URL, e.g. https://foodify.example.com
FRONTEND_URL=http://localhost:5173

# ---- Database ----
MONGODB_URL=mongodb://127.0.0.1:27017/foodify

# ---- Auth ----
# At least 32 random characters in production:  openssl rand -base64 48
JWT_SECRET=

# ---- Redis (optional: caching + shared rate limiting; the API works without it) ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Email (password-reset and delivery OTPs, sent with Resend: https://resend.com) ----
# API key: Resend dashboard > API Keys > Create (needs "Sending access"). Backend only, never a VITE_ variable.
RESEND_API_KEY=
# Sender. For testing only: "Foodify <onboarding@resend.dev>" (Resend delivers it ONLY to your own Resend account email).
# For real users: verify a domain you own in Resend, then use an address on it, e.g. "Foodify <otp@yourdomain.com>".
EMAIL_FROM=

# ---- Firebase Admin (verifies Google sign-in ID tokens) ----
# All three come from ONE service-account JSON key (project_id, client_email, private_key).
# Firebase Console > Project settings > Service accounts > Generate new private key.
# client_email must end with @<project_id>.iam.gserviceaccount.com.
# private_key: paste the whole value on ONE line inside double quotes, keeping the literal \n sequences:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# If any FIREBASE_* value is set, the server validates all three at startup and refuses to boot when they are wrong.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Razorpay (use test-mode keys in development) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Geoapify (address search; key stays on the server) ----
# Free key: https://myprojects.geoapify.com -> create a project -> copy the API key
GEOAPIFY_API_KEY=

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Smart dispatch & ETA (all optional; defaults shown) ----
# DISPATCH_ENABLE_WORKER=true            # false = this instance serves the API but does not run the dispatch worker
# DISPATCH_OFFER_TIMEOUT_SECONDS=30      # how long a partner has to accept an offer
# DISPATCH_MAX_ATTEMPTS=10               # offers placed per order before giving up
# DISPATCH_MAX_WAIT_MINUTES=10           # total time to keep looking for a partner before giving up
# DISPATCH_RETRY_DELAY_SECONDS=10        # pause between searches when nobody is available
# DISPATCH_LOCATION_MAX_AGE_SECONDS=120  # partner positions older than this are ignored
# DISPATCH_MAX_PICKUP_DISTANCE_KM=5
# DISPATCH_AVG_SPEED_KMH=20              # ETA speed assumption (an estimate, not live traffic)
# DISPATCH_ROUTE_FACTOR=1.3              # straight-line distance x this ~ road distance
# DISPATCH_DEFAULT_PREP_MINUTES=15       # used when the owner does not give a preparation time
# DISPATCH_PICKUP_BUFFER_MINUTES=3
# DISPATCH_HANDOFF_BUFFER_MINUTES=3
# DISPATCH_WORKER_CONCURRENCY=5
# DISPATCH_WORKER_INTERVAL_MS=2000

# --- Public browser config, served at /runtime-config.js (NOT secrets) ---
# Project id / Razorpay key id default to FIREBASE_PROJECT_ID / RAZORPAY_KEY_ID.
# VITE_FIREBASE_APIKEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_RAZORPAY_KEY_ID=
# Set true once the SPA's CSP has been verified in a browser (default: report-only)
# CSP_ENFORCE=false
