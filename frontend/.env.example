# Backend base URL
# Development only. In production the server supplies these via /runtime-config.js (leave VITE_API_URL empty: same origin)
VITE_API_URL=http://localhost:5000
# Firebase web API key (public identifier; restrict it by domain in the Firebase console)
# Must belong to the same Firebase project as the two values below
VITE_FIREBASE_APIKEY=
# Razorpay publishable key id (test mode in development)
VITE_RAZORPAY_KEY_ID=
VITE_FIREBASE_PROJECT_ID=
# Optional; defaults to <project id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
