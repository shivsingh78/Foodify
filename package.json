{
  "name": "foodify",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack food ordering and delivery platform",
  "scripts": {
    "postinstall": "pnpm --filter @foodify/validation build",
    "dev": "pnpm --filter @foodify/validation build && pnpm --parallel --filter backend --filter frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @foodify/validation typecheck && pnpm --filter backend typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter frontend lint",
    "start": "pnpm --filter backend start"
  },
  "license": "ISC",
  "packageManager": "pnpm@12.6.0"
}
